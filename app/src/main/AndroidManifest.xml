<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep CPU awake when screen is off so volume buttons still work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Vibration feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required to run as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ when foregroundServiceType="specialUse" is declared -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ requires explicit permission to post notifications -->
    <!-- uses-permission android:name="android.permission.POST_NOTIFICATIONS" / -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Japa">

        <!-- Have Play Services fetch the code-scanner UI module before it is first needed. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/Theme.Japa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/info_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PrayerActivity"
            android:exported="false"
            android:label="@string/prayer_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".UserPrayerActivity"
            android:exported="false"
            android:label="@string/user_prayer_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".QrDisplayActivity"
            android:exported="false"
            android:label="@string/qr_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".PrayerSetActivity" />

        <activity
            android:name=".PrayerImportActivity"
            android:exported="true"
            android:label="@string/import_title"
            android:theme="@style/Theme.Japa">
            <!-- Opening a received .japa file. Matching on the path is unreliable for
                 content:// URIs, which is why the app also offers an explicit Import. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.japa" />
            </intent-filter>
            <!-- "Share with Japa Counter" from a file manager or chat app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".PrayerSetActivity"
            android:exported="false"
            android:label="@string/sets_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".UserPrayerActivity" />

        <activity
            android:name=".UserRecordEditActivity"
            android:exported="false"
            android:label="@string/user_prayer_edit_title"
            android:theme="@style/Theme.Japa"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".UserPrayerActivity" />

        <!--
            Foreground service keeps the counter running with screen off.
            The PARTIAL_WAKE_LOCK inside the service keeps the CPU alive.
        -->
        <service
            android:name=".CounterService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Prayer bead counter running in background with screen off" />
        </service>

    </application>

</manifest>
