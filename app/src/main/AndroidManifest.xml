<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep CPU awake when screen is off so volume buttons still work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Vibration feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required to run as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ when foregroundServiceType="specialUse" is declared -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ requires explicit permission to post notifications -->
    <!-- uses-permission android:name="android.permission.POST_NOTIFICATIONS" / -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Japa">

        <!-- Have Play Services fetch the code-scanner UI module before it is first needed. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/Theme.Japa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/info_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PrayerActivity"
            android:exported="false"
            android:label="@string/prayer_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".vipassana.VipassanaActivity"
            android:exported="false"
            android:label="@string/vipassana_title"
            android:screenOrientation="sensorPortrait"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".PrayerActivity" />

        <activity
            android:name=".UserPrayerActivity"
            android:exported="false"
            android:label="@string/user_prayer_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".QrDisplayActivity"
            android:exported="false"
            android:label="@string/qr_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".PrayerSetActivity" />

        <activity
            android:name=".PrayerImportActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/import_title"
            android:theme="@style/Theme.Japa">
            <!--
                Opening a received .japa file.

                Every <data> attribute in one filter has to be satisfied at once, so a
                pathPattern here would also apply to the typed match below. Chat apps hand
                over opaque URIs such as content://com.whatsapp.provider.media/item/42 with
                no ".japa" anywhere in the path, so the two have to stay separate filters.

                Android has no registry of file extensions, so an app that cannot name the
                type of a .japa file falls back to a generic binary. Claiming octet-stream
                is what makes the file openable from WhatsApp; the cost is that Japa also
                appears in the chooser for other unrecognised files, which the import screen
                turns away after reading them.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!--
                Extension match, for the senders that pass a name but no type at all. A
                filter naming no mimeType only matches an intent that carries none, so this
                complements the one above rather than overlapping it. pathAdvancedPattern is
                a real regex, but the attribute is only read from API 31. The pathPattern
                ladder below covers 26-30: that older glob consumes up to the *first* match
                of whatever follows ".*" and never backtracks, so one pattern per preceding
                dot is what it takes to catch a name like "Morning v1.2 Set.japa".

                The wildcard host is required, not decoration: IntentFilter only tests the
                path patterns once an authority has matched, so without it the patterns are
                skipped and this filter would claim every untyped content:// URI going.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data
                    android:pathAdvancedPattern=".*\\.japa"
                    tools:ignore="UnusedAttribute" />
                <data android:pathPattern=".*\\.japa" />
                <data android:pathPattern=".*\\..*\\.japa" />
                <data android:pathPattern=".*\\..*\\..*\\.japa" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.japa" />
            </intent-filter>
            <!-- "Share with Japa Counter" from a file manager or chat app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".PrayerSetActivity"
            android:exported="false"
            android:label="@string/sets_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".UserPrayerActivity" />

        <activity
            android:name=".UserRecordEditActivity"
            android:exported="false"
            android:label="@string/user_prayer_edit_title"
            android:theme="@style/Theme.Japa"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".UserPrayerActivity" />

        <!--
            Foreground service keeps the counter running with screen off.
            The PARTIAL_WAKE_LOCK inside the service keeps the CPU alive.
        -->
        <service
            android:name=".CounterService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Prayer bead counter running in background with screen off" />
        </service>

    </application>

</manifest>
