<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep CPU awake when screen is off so volume buttons still work -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Vibration feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required to run as a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required on API 34+ when foregroundServiceType="specialUse" is declared -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+ requires explicit permission to post notifications -->
    <!-- uses-permission android:name="android.permission.POST_NOTIFICATIONS" / -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Japa">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:theme="@style/Theme.Japa">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".InfoActivity"
            android:exported="false"
            android:label="@string/info_title"
            android:theme="@style/Theme.Japa"
            android:parentActivityName=".MainActivity" />

        <!--
            Foreground service keeps the counter running with screen off.
            The PARTIAL_WAKE_LOCK inside the service keeps the CPU alive.
        -->
        <service
            android:name=".CounterService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Prayer bead counter running in background with screen off" />
        </service>

    </application>

</manifest>
