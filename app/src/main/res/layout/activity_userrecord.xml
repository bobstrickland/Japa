<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserPrayerActivity">

    <ImageView
        android:id="@+id/bg_image_userrecord"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription=""
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <Spinner
                android:id="@+id/spinner_userrecord_set"
                style="@style/SpinnerStyle"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_manage_sets"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/manage_sets"
                android:src="@drawable/ic_list"
                app:tint="@color/accent_gold" />

            <ImageButton
                android:id="@+id/btn_add_userrecord"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/add_user_prayer"
                android:src="@drawable/ic_add"
                app:tint="@color/accent_gold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:gravity="bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_userrecord_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom|center_horizontal"
                    android:padding="24dp"
                    android:shadowColor="#000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    tools:text="A prayer the user typed in themselves." />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="52dp">

            <ImageButton
                android:id="@+id/btn_prev_prayer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous_prayer"
                android:rotation="90"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/accent_gold" />

            <Spinner
                android:id="@+id/spinner_userrecord"
                style="@style/SpinnerStyle"
                android:layout_width="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_next_prayer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next_prayer"
                android:rotation="90"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/accent_gold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_userrecord_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_user_prayers"
        android:textColor="@color/accent_gold"
        android:textSize="18sp"
        android:visibility="gone"
        tools:visibility="visible" />

</FrameLayout>
