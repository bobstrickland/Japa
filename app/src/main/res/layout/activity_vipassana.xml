<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!--
        The background lives in its own ImageView rather than as a background on the
        ScrollView: centerCrop keeps aum.png in proportion on any screen, and swapping the
        image later — for a per-session choice, say — is then a single setImageResource.
    -->
    <ImageView
        android:id="@+id/bg_image_vipassana"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription=""
        android:scaleType="centerCrop"
        android:src="@drawable/aum" />

    <!--
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />
-->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="64dp"
            android:paddingBottom="32dp">

            <!-- ── Total time ───────────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_total_time"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <NumberPicker
                    android:id="@+id/picker_total_time"
                    style="@style/NumberPickerSmallStyle"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>

            <!-- ── Notice time ──────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/track_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_notice_time"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <NumberPicker
                    android:id="@+id/picker_notice_time"
                    style="@style/NumberPickerSmallStyle"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>

            <!-- ── Sound ────────────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/track_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_vipassana_sound"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Spinner
                    android:id="@+id/spinner_vipassana_sound"
                    style="@style/SpinnerStyle" />

            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/track_dim" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_vipassana_final_sound"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />
                <Space
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <NumberPicker
                    android:id="@+id/picker_vipassana_final_sound_count"
                    style="@style/NumberPickerSmallStyle"
                    android:layout_width="50dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginRight="10dp" />
                <Spinner
                    android:id="@+id/spinner_vipassana_final_sound"
                    style="@style/SpinnerStyle" />
            </LinearLayout>

            <!-- ── Start / Stop ─────────────────────────────────────────────── -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/track_dim" />

            <!--
            <ImageView
                android:id="@+id/bg_image_vipassana_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription=""
                android:scaleType="centerCrop"
                android:src="@drawable/aum" />
            -->


            <Space
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/countdownText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom|center_horizontal"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="00"
                android:textAlignment="center"
                android:textColor="@color/accent_gold"
                android:textSize="52sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/track_dim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="64dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_vipassana_start"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vipassana_start"
                    android:textColor="@color/accent_gold"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/accent_gold"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_vipassana_stop"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/vipassana_stop"
                    android:textColor="@color/accent_gold"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:strokeColor="@color/accent_gold"
                    app:strokeWidth="2dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
